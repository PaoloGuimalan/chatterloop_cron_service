# Copy this file to .env and fill in real values. Never commit .env itself.
LOG_LEVEL=INFO

# Postgres (same as interest_trending / post_scores)
DB_HOST=host
DB_NAME=name
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASS=your-password-here

# Mongo - the Node server's `files` and `messages` (same as worker_service)
MONGODB_CLUSTER_HOST=YOUR_CLUSTER.xxxxx.mongodb.net
MONGODB_CLUSTER_USER=YOUR_MONGO_USER
MONGODB_CLUSTER_PASS=YOUR_MONGO_PASSWORD
MONGODB_DB=chatterloop

# RabbitMQ - candidates go to the media_release queue (same as worker_service)
RABBITMQ_PROTOCOL=amqps
RABBITMQ_USER=user
RABBITMQ_PASS=pass
RABBITMQ_HOST=host
RABBITMQ_PORT=5671
RABBITMQ_VHOST=vhost

# Optional thresholds
# MEDIA_PENDING_AFTER_HOURS=24   an unfinished upload older than this is a candidate
# MEDIA_UNUSED_AFTER_DAYS=7      a finished, never-used upload older than this is one
